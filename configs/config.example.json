{
  "processing": {
    "visual_cut": {
      "enabled": true,
      "sensitivity": 1.0,
      "sample_rate": 5
    },
    "silence_removal": {
      "enabled": false,
      "db_threshold": -40,
      "min_duration": 0.5
    },
    "normalization": {
      "enabled": false
    }
  },
  "subtitles": {
    "enabled": false,
    "format": "srt",
    "burn": false,
    "whisper_model": "base"
  },
  "output": {
    "format": "same",
    "quality": "original",
    "keep_original": true,
    "max_workers": 3
  },
  "logging": {
    "level": "INFO",
    "file": "app.log"
  }
}